{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBUsuariosESessoes",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:SEU_ACCOUNT_ID:table/usuarios",
        "arn:aws:dynamodb:us-east-1:SEU_ACCOUNT_ID:table/usuarios/index/email-index",
        "arn:aws:dynamodb:us-east-1:SEU_ACCOUNT_ID:table/sessoes"
      ]
    }
  ]
}
